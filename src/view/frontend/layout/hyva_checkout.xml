<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.payplug_payments_standard"
                   as="payplug_payments_standard"
                   class="Hyva\CheckoutPayplug\Block\Standard"
                   template="Hyva_CheckoutPayplug::magewire/standard.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\Standard</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/payment-cards.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_oney"
                   as="payplug_payments_oney"
                   class="Payplug\Payments\Block\Oney\Simulation"
                   template="Hyva_CheckoutPayplug::magewire/oney.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\Oney</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/oney.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_oney_without_fees"
                   as="payplug_payments_oney_without_fees"
                   class="Payplug\Payments\Block\Oney\Simulation"
                   template="Hyva_CheckoutPayplug::magewire/oney.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\Oney</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/oney.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_amex"
                   as="payplug_payments_amex">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/amex.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_bancontact"
                   as="payplug_payments_bancontact">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/bancontact.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_ideal"
                   as="payplug_payments_ideal"
                   template="Hyva_CheckoutPayplug::magewire/ppro.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\Ppro</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/ideal.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_mybank"
                   as="payplug_payments_mybank"
                   template="Hyva_CheckoutPayplug::magewire/ppro.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\Ppro</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/mybank.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_satispay"
                   as="payplug_payments_satispay"
                   template="Hyva_CheckoutPayplug::magewire/ppro.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\Ppro</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/satispay.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_apple_pay"
                   as="payplug_payments_apple_pay"
                   class="Hyva\CheckoutPayplug\Block\ApplePay"
                   template="Hyva_CheckoutPayplug::magewire/apple-pay.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Hyva\CheckoutPayplug\Magewire\ApplePay</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Hyva_CheckoutPayplug::svg/payplug/apple_pay.svg</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceContainer name="before.body.end">
            <block class="Payplug\Payments\Block\Formjs"
                   name="payplug-payments-script"
                   template="Hyva_CheckoutPayplug::checkout/payment/method/js/payplug.phtml"
            />
        </referenceContainer>
    </body>
</page>

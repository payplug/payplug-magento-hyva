<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceBlock name="head.components">
            <block class="Payplug\Payments\Block\Formjs" name="payplug_payments_formjs"
                   template="Payplug_Payments::checkout/formjs.phtml"/>
        </referenceBlock>

        <referenceBlock name="checkout.payment.methods">

            <block name="checkout.payment.method.payplug_payments_standard"
                   as="payplug_payments_standard"
                   class="Hyva\CheckoutPayplug\Block\Standard"
                   template="Hyva_CheckoutPayplug::checkout/payment/method/payplug_payments_standard.phtml">
                <arguments>
                    <argument name="paymentMethod" xsi:type="string">Standard</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">visa</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_amex"
                   as="payplug_payments_amex">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">amex</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_bancontact"
                   as="payplug_payments_bancontact">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">bancontact</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_giropay"
                   as="payplug_payments_giropay">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">giropay</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_ideal"
                   as="payplug_payments_ideal">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">ideal</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_mybank"
                   as="payplug_payments_mybank">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">mybank</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_satispay"
                   as="payplug_payments_satispay">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">satispay</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_sofort"
                   as="payplug_payments_sofort">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="svg" xsi:type="string">sofort</item>
                        </item>
                    </argument>
                </arguments>
            </block>

        </referenceBlock>


    </body>

</page>

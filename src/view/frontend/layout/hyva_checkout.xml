<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.payplug_payments_amex"
                   as="payplug_payments_amex">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Payplug_Payments::images/logos/amex.svg</item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="number">34</item>
                                <item name="height" xsi:type="number">34</item>
                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="string">Amex</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.payplug_payments_bancontact"
                   as="payplug_payments_bancontact">
                <arguments>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Payplug_Payments::images/logos/bancontact.svg</item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="number">55</item>
                                <item name="height" xsi:type="number">34</item>
                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="string">Bancontact</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceContainer name="before.body.end">
            <block class="Payplug\Payments\Block\Formjs"
                   name="payplug-payments-script"
                   template="Hyva_CheckoutPayplug::checkout/payment/method/js/payplug.phtml"
            />
        </referenceContainer>
        <referenceContainer name="magewire.plugin.scripts">
            <block name="oney.simulation"
                   template="Hyva_CheckoutPayplug::oney/simulation-csp-js.phtml"
            />
            <block name="oney.simulation_content"
                   template="Hyva_CheckoutPayplug::oney/simulation_content-csp-js.phtml"
            />
        </referenceContainer>
    </body>
</page>

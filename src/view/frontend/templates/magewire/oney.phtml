<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\CheckoutPayplug\ViewModel\PayplugIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Payplug\Payments\Block\Oney\Simulation;
use Magento\Framework\Pricing\Helper\Data;
use Payplug\Payments\Gateway\Config\OneyWithoutFees;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var Simulation $block */

$hasError = false;
$oneySimulation = $block->getOneySimulation();
$message = $oneySimulation->getMessage();

if (!$oneySimulation->getSuccess() || !empty($message)) {
    $hasError = true;
}

$isOneyWithoutFees = $oneySimulation->getMethod() === OneyWithoutFees::METHOD_CODE;
$pricingHelper = $this->helper(Data::class);

/** @var PayplugIcons $viewModels */
$icons = $viewModels->require(PayplugIcons::class);
?>
<div data-oney-container="payplug_payments_oney">
    <div class="oneyPayment oneyPayment-open"></div>
</div>

<div class="payment-method-content"></div>

<span class="oneyPopin <?php if ($hasError): ?>oneyPopin-error<?php endif; ?>"></span>

<style>
    <?php if($isOneyWithoutFees): ?>
        .oneyLogo-3x {
            background-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('oney_without_fees/3x')); ?>');
        }
        .oneyLogo-4x {
            background-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('oney_without_fees/4x')); ?>');
        }
    <?php else: ?>
        .oneyLogo-3x {
            background-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('3x')); ?>');
        }
        .oneyLogo-4x {
            background-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('4x')); ?>');
        }
    <?php endif; ?>
</style>

<div x-data="srcViewFrontendTemplatesMagewireOney" x-init="srcViewFrontendTemplatesMagewireOneyInit1" data-hyvacsp1="<?= $escaper->escapeHtmlAttr(__('In 30 days')); ?>" data-hyvacsp2="<?= $escaper->escapeHtmlAttr(__('In 60 days')); ?>" data-hyvacsp3="<?= $escaper->escapeHtmlAttr(__('In 90 days')); ?>" data-hyvacsp4="<?= $escaper->escapeHtmlAttr(__('Place Order')); ?>" data-hyvacsp5="<?php $label = $isOneyWithoutFees ? 'Payment in %1 without fees' : 'Payment in %1'; ?>" data-hyvacsp6="<?= $escaper->escapeHtmlAttr(__($label)) ?>" data-hyvacsp7="<?php if ($hasError): ?>" data-hyvacsp8="<?= $escaper->escapeHtmlAttr($message); ?>" data-hyvacsp9="<?php else : ?>" data-hyvacsp10="<?php foreach ($oneySimulation->getOptions() as $option) : ?>" data-hyvacsp11="<?= $escaper->escapeHtmlAttr($option->getType()); ?>" data-hyvacsp12="<?php // Title ?>" data-hyvacsp13="<?php if ($option->getSchedules()) : ?>" data-hyvacsp14="<?= $escaper->escapeHtmlAttr(__('Total order amount')); ?>" data-hyvacsp15="<?= $escaper->escapeHtmlAttr($pricingHelper->currency($option->getFirstDeposit(), true, false)); ?>" data-hyvacsp16="<?php foreach ($option->getSchedules() as $i => $schedule): ?>" data-hyvacsp17="<?= $escaper->escapeHtmlAttr(__(sprintf('Installment %d:', $i + 1))); ?>" data-hyvacsp18="<?= $escaper->escapeHtmlAttr($pricingHelper->currency($schedule->getAmount(), true, false)); ?>" data-hyvacsp19="<?php endforeach; ?>" data-hyvacsp20="<?= $escaper->escapeHtmlAttr(__('Total cost')); ?>" data-hyvacsp21="<?= $escaper->escapeHtmlAttr($pricingHelper->currency($option->getTotalAmount(), true, false)); ?>" data-hyvacsp22="<?php endif; ?>" data-hyvacsp23="<?php endforeach; ?>" data-hyvacsp24="<?php endif; ?>" data-hyvacsp25="<?php // Reset place order button to default value ?>" data-hyvacsp26="<?= $escaper->escapeHtmlAttr(__('Place Order')); ?>"></div>

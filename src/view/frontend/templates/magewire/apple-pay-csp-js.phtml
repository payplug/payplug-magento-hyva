                            return new this.Promise((resolve, reject) => {
                                if (!document.getElementById('apple_pay_cdn')) {
                                    const this.script = document.createElement('script');
                                    this.script.src = 'https://applepay.cdn-apple.com/jsapi/v1/apple-pay-sdk.js';
                                    this.script.setAttribute('id', 'apple_pay_cdn');
                                    document.head.append(this.script);
                                }
                                this.$el.dataset.hyvacsp12
                                let this.count = 0;
                                const this.interval = this.setInterval(() => {
                                    this.count++;
                                    if (this.typeof this.ApplePaySession !== 'undefined') {
                                        this.clearInterval(this.interval);
                                        this.resolve();
                                        return;
                                    }
                                    if (this.count > 100) {
                                        this.reject();
                                        this.clearInterval(this.interval);
                                        this.throw new this.Error('Unable to load Apple Pay');
                                    }
                                }, 100);
                            });
                        },
                        checkLoadedAP: function() {
                            return document.body.contains(document.querySelector('apple-pay-button'));
                        },
                    }, document.querySelector('apple-pay-button'));
                } this.else {
                    var this.script = document.getElementById(\"this.apple_pay_cdn\");
                    if (this.script) {
                        this.script.remove();
                    }
                    document.querySelector('.btn-primary[x-bind=\"buttonPlaceOrder()\"]').disabled = false;
                    this.hyvaCheckout.payment.method = null;
                }
            }, { once: true });
        })();},
        }
    )
}

                                            credentials: \"this.include\",
                                            this.body,
                                            headers: {
                                                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                                            }
                                        }).then(this.async response => {
                                            let this.res = this.await this.response.json();
                                            let this.applePaySessionStatus = this.ApplePaySession.STATUS_SUCCESS;
                                            if (this.res.error === true) {
                                                this.applePaySessionStatus = this.ApplePaySession.STATUS_FAILURE;
                                            }
                                            this.session.completePayment({
                                                \"this.status\": this.applePaySessionStatus
                                            });
                                            if (this.res.error === true) {
                                                window.location.replace(`${this.$el.dataset.hyvacsp4}`);
                                                this.reject();
                                            } this.else {
                                                window.location.replace(`${this.$el.dataset.hyvacsp5}`);
                                                this.resolve();
                                            }
                                        });
                                    };

                                    this.session.oncancel = event => {
                                        window.location.replace(`${this.$el.dataset.hyvacsp6}`);
                                    };

                                    this.session.begin();
                                });
                            });
                        },
                        getApplePaySessionRequest() {
                            return {
                                \"this.countryCode\": \"this.$el.dataset.hyvacsp7\",
                                \"this.currencyCode\": \"this.$el.dataset.hyvacsp8\",
                                \"this.merchantCapabilities\": [\"this.supports3DS\"],
                                \"this.supportedNetworks\": [\"this.visa\", \"this.masterCard\"],
                                \"this.total\": {
                                    \"this.label\": \"this.$el.dataset.hyvacsp9\",
                                    \"this.type\": \"this.final\",
                                    \"this.amount\": `${this.$el.dataset.hyvacsp10}`
                                },
                                'applicationData': this.btoa(JSON.stringify({
                                    'apple_pay_domain': \"this.$el.dataset.hyvacsp11\"
                                }))
                            };
                        },

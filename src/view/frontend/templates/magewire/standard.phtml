            <?php if ($paymentConfig["payplug_payments_standard"]['is_one_click']) : ?>
                <div class="save-card-container">
                    <input type="checkbox" name="save_card" id="payplug_save_card">
                    <label for="payplug_save_card"><?= $escaper->escapeHtml(__('Save my credit card')); ?></label>
                </div>

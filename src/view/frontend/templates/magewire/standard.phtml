            <div class="transaction-secured">
                <img src="data:image/svg+xml,<?= rawurlencode($icons->renderHtml('lock')); ?>" alt="">
                <span><?= $escaper->escapeHtml(__('Transaction secured by')); ?></span>
                <img class="payplug-logo" src="data:image/svg+xml,<?= rawurlencode($icons->renderHtml('payplug')); ?>" alt="">
            </div>
        </div>

        <style>
            .IntegratedPayment_container.-cardHolder::before {
                mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('account')); ?>');
                -webkit-mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('account')); ?>');
            }

            .IntegratedPayment_container.-pan::before {
                -webkit-mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('card')); ?>');
                mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('card')); ?>');
            }

            .IntegratedPayment_container.-exp,
            .IntegratedPayment_container.-cvv {
                display: block;
                max-width: calc(140px);
            }

            .IntegratedPayment_container.-cvv::before {
                mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('lock')); ?>');
                -webkit-mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('lock')); ?>');
            }

            .IntegratedPayment_container.-exp::before {
                mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('calendar')); ?>');
                -webkit-mask-image: url('data:image/svg+xml,<?= rawurlencode($icons->renderHtml('calendar')); ?>');
            }
        </style>
    <?php endif; ?>

    <script>
        (() => {
            let isOneClick = <?= !empty($payplugCards) && $isOneClick ? 'true' : 'false'; ?>;

            <?php if ($isIntegrated) : ?>
                const IntegratedPayment = {
                    props: {
                        cartId: null,
                        paymentId: null,
                        paymentOptionId: null,
                        form: {},
                        checkoutForm: null,
                        api: null,
                        integratedPayment: null,
                        token: null,
                        notValid: true,
                        fieldsValid: {
                            cardHolder: false,
                            pan: false,
                            cvv: false,
                            exp: false,
                        },
                        fieldsEmpty: {
                            cardHolder: true,
                            pan: true,
                            cvv: true,
                            exp: true,
                        },
                        inputStyle: {
                            default: {
                                color: '#2B343D',
                                fontFamily: 'Poppins, sans-serif',
                                fontSize: '14px',
                                textAlign: 'left',
                                '::placeholder': {
                                    color: '#969a9f',
                                },
                                ':focus': {
                                    color: '#2B343D',
                                }
                            },
                            invalid: {
                                color: '#E91932'
                            }
                        },
                        save_card: false,
                        scheme: null,
                        query: null,
                        submit: null,
                        order_review: false,
                        return_url: null
                    },
                    init: function () {
                        IntegratedPayment.props.api = new Payplug.IntegratedPayment(<?= $escaper->escapeJs($paymentConfig['payplug_payments_standard']['is_sandbox']); ?>);
                        IntegratedPayment.props.api.setDisplayMode3ds(Payplug.DisplayMode3ds.LIGHTBOX);
                        IntegratedPayment.props.form = {};
                        IntegratedPayment.props.form.cardHolder = {element: IntegratedPayment.props.api.cardHolder(document.querySelector('#cardholder-input-container'), {default: IntegratedPayment.props.inputStyle.default, placeholder: 'Name'})};
                        IntegratedPayment.props.form.pan = {element:IntegratedPayment.props.api.cardNumber(document.querySelector('#pan-input-container'), {default: IntegratedPayment.props.inputStyle.default, placeholder: 'Card Number'})};
                        IntegratedPayment.props.form.cvv = {element:IntegratedPayment.props.api.cvv(document.querySelector('#cvv-input-container'), {default: IntegratedPayment.props.inputStyle.default, placeholder: 'CVV'})};
                        IntegratedPayment.props.form.exp = {element:IntegratedPayment.props.api.expiration(document.querySelector('#exp-input-container'), {default: IntegratedPayment.props.inputStyle.default, placeholder: 'Exp Date'})};
                        IntegratedPayment.props.scheme = IntegratedPayment.props.api.getSupportedSchemes();
                    },
                };
            <?php endif; ?>

            window.addEventListener('checkout:payment:method-activate', (event) => {
                const MAGEWIRE_STANDARD_ID = '<?= /* @NoEscape */ $magewire->getId() ?>';
                const MAGEWIRE_STANDARD_SELECTOR = document.querySelector(`[wire\\:id="${ MAGEWIRE_STANDARD_ID }"]`);

                if (event.detail.method == "payplug_payments_standard") {
                    hyvaCheckout.payment.activate('payplug_payments_standard', {
                        initialize() {
                            this.loadHostedLib()
                                <?php if ($isIntegrated) : ?>
                                    .then(() => {
                                        if (!this.isInitialized()) {
                                            IntegratedPayment.init();
                                        }
                                    });
                                <?php endif; ?>
                        },
                        <?php if ($isIntegrated) : ?>
                            isInitialized() {
                                return document.body.contains(document.getElementById('cardholder'));
                            },
                        <?php endif; ?>
                        async validate() {
                            let cardIsSelected = false;

                            if (document.querySelector('input[name="payment[payplug_payments_standard][customer_card_id]"]:checked') != null) {
                                if (document.querySelector('input[name="payment[payplug_payments_standard][customer_card_id]"]:checked').value) {
                                    cardIsSelected = true;
                                }
                            }

                            if (isOneClick && cardIsSelected) {
                                const selectedElement = document.querySelector('input[name="payment[payplug_payments_standard][customer_card_id]"]:checked');
                                const cartId = selectedElement.value;

                                await Magewire.find('checkout.payment.method.payplug_payments_standard').call('setAditionalData', cartId);
                                hyvaCheckout.main.getWireComponent().placeOrder();
                                resolve();

                                return true;
                            } else {
                                <?php if ($isIntegrated) : ?>
                                    hyvaCheckout.evaluation.registerExecutable('make:pay-plug:payment', async () => {
                                        <?php // Just simulating a 5 seconds API request ?>
                                        return new Promise((resolve) => {
                                            IntegratedPayment.props.api.setDisplayMode3ds(Payplug.DisplayMode3ds.LIGHTBOX);
                                            IntegratedPayment.props.api.validateForm()
                                            IntegratedPayment.props.api.onValidateForm(({isFormValid}) => {
                                                magewire.plugins.loader.start();
                                                if (isFormValid) {
                                                    fetch('<?= $escaper->escapeUrl($block->getUrl("payplug_payments/payment/standard", ['_query' => ['should_redirect' => '0', 'integrated' => '1']])); ?>').then(response => {
                                                        let res = response.clone().json();
                                                        res.then(result => {
                                                            if (typeof result.error !== 'undefined' && result.error) {
                                                                window.location.replace(response.url);
                                                                reject();

                                                            } else {
                                                                if (typeof result.payment_id !== undefined && result.payment_id) {
                                                                    let save_card = false;
                                                                    if (document.querySelector("#payplug_save_card") != null &&
                                                                        typeof document.querySelector("#payplug_save_card") != "undefined" &&
                                                                        document.querySelector("#payplug_save_card").checked) {
                                                                        save_card = true;
                                                                    }

                                                                    IntegratedPayment.props.api.pay(result.payment_id, 0, {save_card: save_card});
                                                                    IntegratedPayment.props.api.onCompleted(function (event) {
                                                                        window.location.replace('<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/paymentReturn')); ?>');
                                                                        resolve();
                                                                    });

                                                                } else {
                                                                    window.location.replace('<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/cancel')); ?>');
                                                                    reject();
                                                                }
                                                            }
                                                        });
                                                    });
                                                } else {
                                                    reject();
                                                    magewire.plugins.loader.stop();
                                                    document.querySelector('.btn-primary[x-bind="buttonPlaceOrder()"]').disabled = false;
                                                    return false;
                                                }
                                            });
                                        });
                                    });
                                <?php endif; ?>

                                <?php if ($isPopup) : ?>
                                    const redirectUrl = 'payplug_payments/payment/standard';
                                    const returnUrl = 'payplug_payments/payment/paymentReturn';

                                    fetch(`${BASE_URL}${redirectUrl}?should_redirect=0`)
                                        .then(response => response.json())
                                        .then(({ is_paid, url }) => {
                                            if (is_paid) {
                                                window.location.replace(`${BASE_URL}${returnUrl}`);
                                            } else if (url) {
                                                Payplug.Form.showPayment(url, isOneClick);
                                            } else {
                                                this.redirectToCancelUrl();
                                            }
                                        })
                                        .catch(console.error);
                                <?php endif; ?>
                            }

                            hyvaCheckout.main.getWireComponent().placeOrder();
                            resolve();
                            return true;
                        },
                        <?php if ($isPopup) : ?>
                            redirectToCancelUrl() {
                                const cancelUrl = 'payplug_payments/payment/cancel';
                                window.location.replace(`${BASE_URL}${cancelUrl}?form_key=${hyva.getFormKey()}`);
                            },
                            placeOrderViaJs() {
                                <?php // Disable place order ?>
                                return true;
                            },
                        <?php endif; ?>
                        loadHostedLib() {
                            return new Promise((resolve, reject) => {
                                if (!document.getElementById('payplug_hosted_lib')) {
                                    const script = document.createElement('script');
                                    script.src = 'https://cdn.payplug.com/js/integrated-payment/v1@1/index.js';
                                    script.setAttribute('id', 'payplug_hosted_lib');
                                    document.head.append(script);
                                }
                                //if it's not loaded yet let's wait 100ms to load it
                                let count = 0;
                                const interval = setInterval(() => {
                                    count++;
                                    if (typeof Payplug !== 'undefined') {
                                        clearInterval(interval);
                                        resolve();
                                        return;
                                    }
                                    if (count > 100) {
                                        reject();
                                        clearInterval(interval);
                                        throw new Error('Unable to load Payplug');
                                    }
                                }, 100);
                            });
                        },
                    }, MAGEWIRE_STANDARD_SELECTOR);

                    if (document.querySelector('ul.payplug-payments-cards li') != null) {
                        document.querySelector('ul.payplug-payments-cards li input').click();
                        document.querySelector('ul.payplug-payments-cards').addEventListener('change', function () {
                            var card = document.querySelector('input[name="payment[payplug_payments_standard][customer_card_id]"]:checked');
                            if (card.value === '') {
                                isOneClick = false;

                                <?php if ($isIntegrated) : ?>
                                    document.querySelector("#payplug-payment-form").classList.remove("-hide");
                                <?php endif; ?>
                            } else {
                                isOneClick = true;

                                <?php if ($isIntegrated) : ?>
                                    document.querySelector("#payplug-payment-form").classList.add("-hide");
                                <?php endif; ?>
                            }
                        });
                    }
                } else {
                    var script = document.getElementById("payplug-js");
                    if (script) {
                        script.remove();
                    }
                    document.querySelector('.btn-primary[x-bind="buttonPlaceOrder()"]').disabled = false;
                    hyvaCheckout.payment.method = null;
                }
            }, {once: true});

            <?php if ($isIntegrated) : ?>
                const cardholder = document.querySelector('#cardholder-input-container');
                const pan = document.querySelector('#pan-input-container');
                const exp = document.querySelector('#exp-input-container');
                const cvv = document.querySelector('#cvv-input-container');
                const options = { attributes: true }
                function callback(mutationList, observer) {
                    mutationList.forEach(function(mutation) {
                        if ( mutation.attributeName === 'class' ) {
                            if (mutation.target.classList.contains("integrated_payment_error")) {
                                mutation.target.style.border = "1px solid #FF0000";
                                let id = mutation.target.id
                                document.querySelector('.error-container.'+id+ ' .invalid-field').style.display = "block";
                            } else {
                                let id = mutation.target.id
                                mutation.target.style.border = "1px solid #d5d6d8";
                                document.querySelector('.error-container.'+id+ ' .invalid-field').style.display = "none";
                            }
                        }
                    })
                }
                const observer = new MutationObserver(callback)
                observer.observe(cardholder, options)
                observer.observe(pan, options)
                observer.observe(exp, options)
                observer.observe(cvv, options)
            <?php endif; ?>
        })();
    </script>
</div>

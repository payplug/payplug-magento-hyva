    <?php if ($isIntegrated) : ?>
        <div id="payplug-payment-form" class="payplug IntegratedPayment -loaded <?= !empty($payplugCards) && $isOneClick ? '-hide' : '' ?>">
            <div id="cardholder-input-container" class="payplug IntegratedPayment_container -cardHolder cardHolder-input-container" data-e2e-name="cardHolder">
            </div>
            <div class="error-container cardholder-input-container">
                <div class="invalid-field"><span><?= $escaper->escapeHtml(__('Invalid Name and/or Last Name.')); ?></span></div>
                <div class="empty-field"><span><?= $escaper->escapeHtml(__('Mandatory field.')); ?></span></div>
            </div>
            <div class="payplug IntegratedPayment_container -scheme">
                <div>
                    <?= $escaper->escapeHtml(__('Your card')); ?>
                </div>
                <div x-data="{ currentCard: '' }"
                     class="flex justify-between items-center flex-wrap w-[115px]">
                    <label class="hover:cursor-pointer">
                        <span class="sr-only">Visa</span>
                        <span :class="currentCard === 'visa' ? 'inline' : 'hidden'" x-cloak>
                            <?= $icons->renderHtml('visa', 'w-payment-card h-payment-card', 33, 22, ['aria-hidden' => 'true']); ?>
                        </span>
                        <span :class="currentCard === 'visa' ? 'hidden' : 'inline'">
                            <?= $icons->renderHtml('visa-dark', 'w-payment-card h-payment-card', 33, 22, ['aria-hidden' => 'true']); ?>
                        </span>
                        <input type="radio"
                               class="sr-only"
                               name="schemeOptions"
                               value="visa"
                               x-model="currentCard" />
                    </label>
                    <label class="hover:cursor-pointer">
                        <span class="sr-only">Mastercard</span>
                        <span :class="currentCard === 'mastercard' ? 'inline' : 'hidden'" x-cloak>
                            <?= $icons->renderHtml('mastercard', 'w-payment-card h-payment-card', 33, 22, ['aria-hidden' => 'true']); ?>
                        </span>
                        <span :class="currentCard === 'mastercard' ? 'hidden' : 'inline'">
                            <?= $icons->renderHtml('mastercard-dark', 'w-payment-card h-payment-card', 33, 22, ['aria-hidden' => 'true']); ?>
                        </span>
                        <input type="radio"
                               class="sr-only"
                               name="schemeOptions"
                               value="mastercard"
                               x-model="currentCard" />
                    </label>
                    <label class="hover:cursor-pointer">
                        <span class="sr-only">
                            <?= $escaper->escapeHtml($storeCode === 'it_IT' ? 'PostePay' : 'CB') ?>
                        </span>
                        <span :class="currentCard === 'cb' ? 'inline' : 'hidden'" x-cloak>
                            <?= $icons->renderHtml($cbName, 'w-payment-card h-payment-card', 33, 22, ['aria-hidden' => 'true']); ?>
                        </span>
                        <span :class="currentCard === 'cb' ? 'hidden' : 'inline'">
                        <?= $icons->renderHtml($cbName . '-dark', 'w-payment-card h-payment-card', 33, 22, ['aria-hidden' => 'true']); ?>
                        </span>
                        <input type="radio"
                               class="sr-only"
                               name="schemeOptions"
                               value="cb"
                               x-model="currentCard" />
                    </label>
                </div>
            </div>
            <div id="pan-input-container" class="payplug IntegratedPayment_container -pan pan-input-container" data-e2e-name="pan"></div>
            <div class="error-container pan-input-container">
                <div class="invalid-field"><span><?= $escaper->escapeHtml(__('Invalid card number.')); ?></span></div>
                <div class="empty-field"><span><?= $escaper->escapeHtml(__('Mandatory field.')); ?></span></div>
            </div>
            <div class="exp-cvv-container">
                <div>
                    <div id="exp-input-container" class="payplug IntegratedPayment_container -exp exp-input-container" data-e2e-name="expiration"></div>
                    <div class="error-container exp-input-container">
                        <div class="invalid-field"><span><?= $escaper->escapeHtml(__('Invalid expiration date.')); ?></span></div>
